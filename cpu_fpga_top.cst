# test of LED flash light on TANG NANO 20K, constraint of output

IO_LOC  "clk_27m" 4;
IO_PORT "clk_27m" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
CLOCK_LOC "clk_27m" BUFG;

IO_LOC  "led0_n" 15;
IO_PORT "led0_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

# constraint of UART 

IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;